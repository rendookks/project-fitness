{
  "expo": {
    "name": "Project Fitness",
    "slug": "project-fitness",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "projectfitness",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D16"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
