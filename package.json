{
  "name": "project-fitness",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start --go",
    "ios": "expo start --go --ios",
    "android": "expo start --go --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "validate": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:sqlite && npm run test:calendar && npm run test:demo-sqlite",
    "doctor": "npx expo-doctor@latest",
    "export:check": "expo export --platform ios --platform android --platform web",
    "preview:web": "node scripts/serve-web.cjs",
    "test:sqlite": "tsx scripts/verify-sqlite.ts",
    "test:calendar": "node scripts/verify-timezones.cjs",
    "test:e2e": "playwright test",
    "test:demo-sqlite": "tsx scripts/verify-demo-sqlite.ts"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^58.0.25",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
